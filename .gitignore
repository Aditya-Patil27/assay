# Data — never commit raw datasets
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Models are regenerable; artifacts/ (results) ARE committed on purpose — see spec 4.3
models/
*.ubj
*.joblib
*.pkl

# LLM credentials
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Prefect local state
.prefect/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / Next
web/node_modules/
web/.next/
web/out/
web/public/data/
next-env.d.ts

# Demo video: the pipeline is committed, its outputs are not. Regenerate with video/mux.sh.
video/node_modules/
video/raw/
video/audio/
video/offset.txt
video/timeline.json
video/*.mp4
video/audio_wf/
video/raw_wf/
video/workflow_ms.txt

# TypeScript incremental build cache. Regenerated by every `tsc` run, so committing it
# meant a 258KB binary diff on unrelated commits and a permanently dirty tree.
*.tsbuildinfo
# Ruff's cache, present on disk and previously neither tracked nor ignored.
.ruff_cache/
