# Approach B needs one OpenAI-compatible endpoint. Pick either provider.
#
# OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=anthropic/claude-sonnet-4.5
#
# NVIDIA NIM:
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=meta/llama-3.3-70b-instruct

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# 1 = call the live provider, 0 = replay cached responses from artifacts/cache
LLM_LIVE=0

# --- additional providers -----------------------------------------------------------
# The same corpus is run once per provider, never load-balanced across them: each has its
# own free-tier quota, and a single exploit rate spread over several models would belong to
# no model at all. Each provider writes its own artifact naming its model.
#
#   python -m adversarial_payments.agentic.redteam --provider groq   --minimal --write
#   python -m adversarial_payments.agentic.redteam --provider nvidia --minimal --write
#
# Groq:       https://console.groq.com/keys
# NVIDIA NIM: https://build.nvidia.com
#
# Override the model per provider with GROQ_MODEL / NVIDIA_MODEL if the default 404s --
# free catalogues churn.
GROQ_API_KEY=
NVIDIA_API_KEY=
